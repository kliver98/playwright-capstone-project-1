{
  "name": "playwright-capstone-project-1",
  "version": "1.0.0",
  "description": "Playwright project to automate tests in a web page",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:serial": "playwright test --workers=1",
    "test:accessibility": "playwright test tests/accessibility.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:visual:update": "playwright test tests/visual.spec.ts --update-snapshots",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report reports/html-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kliver98/playwright-capstone-project-1.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/kliver98/playwright-capstone-project-1/issues"
  },
  "homepage": "https://github.com/kliver98/playwright-capstone-project-1#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
